{
    "version": "0.0.0",
    "description": "Zeugwerk documentation tool for TwinCAT PLC projects",
    "homepage": "https://zeugwerk.dev",
    "license": "commercial",
    "architecture": {
        "64bit": {
            "url": "https://api.zeugwerk.dev/download?tool=zkdoc&version=0.0.0",
            "hash": "sha256:PLACEHOLDER",
            "download_headers": {
                "Authorization": "Bearer #{ZEUGWERK_TOKEN}#"
            }
        }
    },
    "bin": "zkdoc.exe",
    "checkver": {
        "url": "https://api.zeugwerk.dev/version?tool=zkdoc",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://api.zeugwerk.dev/download?tool=zkdoc&version=$version"
            }
        }
    }
}
